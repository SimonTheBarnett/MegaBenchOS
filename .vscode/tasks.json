{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "Build",
                      "type":  "process",
                      "command":  "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                      "args":  [
                                   "-NoProfile",
                                   "-Command",
                                   ". ./scripts/env.ps1; make build; exit $LASTEXITCODE"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}"
                                  },
                      "problemMatcher":  [
                                             "$gcc"
                                         ],
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                }
                  },
